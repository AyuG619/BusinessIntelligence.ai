# Choose one provider and set its key. If left blank (or LLM_PROVIDER=offline),
# llm/client.py falls back to a deterministic offline template narrative and
# a keyword-based evidence classifier, so the app still runs end-to-end
# without any key configured.

LLM_PROVIDER=groq            # groq | gemini | openai | anthropic | offline

# Pick a model your API key has access to — check your provider's current
# model list before running, model names change over time:
#   gemini:    e.g. gemini-1.5-flash, gemini-2.0-flash (see ai.google.dev/models)
#   openai:    e.g. gpt-4o-mini, gpt-4o (see platform.openai.com/docs/models)
#   anthropic: e.g. claude-haiku-4-5-20251001, claude-sonnet-5 (see docs.claude.com)
LLM_MODEL=qwen/qwen3.8-27b

LLM_API_KEY="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"

DB_PATH=db/banking.db
